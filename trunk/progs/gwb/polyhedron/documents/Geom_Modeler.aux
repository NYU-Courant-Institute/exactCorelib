\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Solid}{1}{subsection.2.2}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Polyhedron}{1}{subsection.2.3}}
\@writefile{toc}{\contentsline {section}{\numberline {3}CSG objects}{1}{section.3}}
