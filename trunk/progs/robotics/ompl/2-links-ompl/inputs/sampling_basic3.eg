# non-crossing-2-links Motion Planning example
# basic input

startX = 250		# start configuration
startY = 360
startTheta1 = 0	# in degrees
startTheta2 = 150	# in degrees

goalX = 260			# goal configuration
goalY = 80
goalTheta1 = 70	# in degrees
goalTheta2 = 320	# in degrees

len1 = 50		# link1 length
len2 = 80		# link2 
thickness = 0   # link thickness

inputDir = inputs	# where to find input files
fileName = basic3.txt	# input environment file

boxWidth = 512		# initial configuration box size
boxHeight = 512

method = prm

maxSampleSize = 20000

rrtStepSize = 1
rrtBias = 0.1
rrtClose2Goal = 0.01

prmClosestK = 20

GaussianMean = 0.01
GaussianStd = 0.01

seed = 11		# seed for random

xtrans = 0	# x-translation of input file
ytrans = 0	# y-translation of input file
scale = 1	# scaling of input file

animationSpeed = 10
animationSpeedScale = 5000